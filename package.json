{
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "better-sqlite3": "^12.4.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  },
  "name": "agent-treasury",
  "version": "0.1.0-rc.2",
  "description": "AI Agent Financial & Payment Layer",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --testTimeout=30000",
    "test:mcp": "npx tsx tests/mcp-e2e.ts",
    "test:integration": "npx tsx tests/integration-sqlite.ts",
    "test:gate5": "npx tsx tests/gate5-tests.ts",
    "test:gate45": "npx tsx tests/gate45-runner.ts",
    "test:service": "npx tsx tests/unified-service-e2e.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:integration && npm run test:mcp && npm run test:service && npm run test:gate45 && npm run test:gate5",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/run-demo.js",
    "demo:server": "TREASURY_DB_PATH=./data/treasury-demo.db npx tsx src/server/demoServer.ts",
    "service": "npx tsx src/server/unifiedService.ts",
    "demo:ui": "open http://localhost:5173",
    "ui:build": "cd apps/demo-ui && npm run build",
    "screenshot": "cd apps/demo-ui && node screenshot-ui.js"
  },
  "keywords": [
    "ai-agent",
    "payment",
    "treasury",
    "binance",
    "x402",
    "mcp"
  ]
}
