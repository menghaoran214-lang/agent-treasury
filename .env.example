# Treasury Environment Variables

## Database
TREASURY_DB_PATH=./data/treasury.db

## Payment Provider
# Set to 'binance' to use real Binance Agentic Wallet (baw CLI)
# Set to 'mock' (default) to use mock payment
TREASURY_PAYMENT_MODE=mock

# Path to baw CLI (default: 'baw' — must be in PATH, or use absolute path)
# Install: npm install -g @binance/agentic-wallet
BAW_CLI_PATH=baw

# Blockchain chain ID for Binance payments
# 56 = BSC Mainnet, 97 = BSC Testnet, CT_501 = Solana
TREASURY_WALLET_CHAIN_ID=56

# Token contract address for payments (USDT on BSC mainnet)
TREASURY_PAYMENT_TOKEN=0x55d398326f99059fF775485246999027B3197955

## Security
# Never commit real credentials to repo
# Binance wallet authentication requires human QR scan via baw auth signin
